<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Invoice_RFC_Required</fullName>
    <active>true</active>
    <description>US-06 AC1: an invoice needs the RFC.</description>
    <errorConditionFormula>AND(RecordType.DeveloperName = 'Donation', Invoice_Requested__c, ISBLANK(RFC__c))</errorConditionFormula>
    <errorDisplayField>RFC__c</errorDisplayField>
    <errorMessage>Captura tu RFC para solicitar factura.</errorMessage>
</ValidationRule>
