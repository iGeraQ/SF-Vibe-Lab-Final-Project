<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Donation_Type__c</fullName>
    <description>Donation type for staff lists (US-03 AC3, US-09 AC1), from the anonymous and invoice checkboxes.</description>
    <formula>IF(Is_Anonymous__c, IF(Invoice_Requested__c, &quot;Anónima con factura&quot;, &quot;Anónima&quot;), IF(Invoice_Requested__c, &quot;Factura&quot;, &quot;Acreditada&quot;))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Tipo de donación</label>
    <required>false</required>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
