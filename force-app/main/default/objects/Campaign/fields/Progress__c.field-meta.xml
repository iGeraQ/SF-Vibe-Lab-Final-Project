<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Progress__c</fullName>
    <description>Raised amount over the goal. Raised = paid donations (US-01).</description>
    <formula>IF(ExpectedRevenue &gt; 0, AmountWonOpportunities / ExpectedRevenue, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Avance</label>
    <precision>18</precision>
    <scale>0</scale>
    <type>Percent</type>
</CustomField>
